# Velarith Environment Variables Configuration
# Copy this file to .env.local and fill in your API keys

# ============================================
# REQUIRED: Anthropic Claude AI
# ============================================
# Get your API key from: https://console.anthropic.com/
# Used for: AI Financial Assistant, streaming chat responses
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# REQUIRED: Finnhub Stock Market Data
# ============================================
# Get your API key from: https://finnhub.io/register
# Free tier: 60 API calls/minute
# Used for: Real-time stock quotes, market data
FINNHUB_API_KEY=your_finnhub_api_key_here

# ============================================
# OPTIONAL: Polymarket API
# ============================================
# Public API, no key required for basic access
# Used for: Prediction market data
NEXT_PUBLIC_POLYMARKET_API_URL=https://api.polymarket.com/v1

# ============================================
# OPTIONAL: Backend Configuration
# ============================================
# If running Python backend locally
# Development: http://localhost:5000
# Production: Your Render backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ============================================
# OPTIONAL: Application Configuration
# ============================================
# Development: http://localhost:3000
# Production: Your Vercel deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DEVELOPMENT ONLY (Do not use in production)
# ============================================
# NODE_ENV is automatically set by Next.js
# NODE_ENV=development

