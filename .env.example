# Velarith — Frontend Environment Variables
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Full per-variable docs live in .agents/api-keys.md

# ======================
# AI providers (two-tier routing)
# ======================
# Primary: Anthropic Claude Sonnet 4.5 — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# Fallback: Groq Llama 3.3 70B — get key at https://console.groq.com (free, no credit card)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Provider routing — swap these env values only, no code changes needed
AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_PROVIDER=groq
AI_PRIMARY_MODEL=claude-sonnet-4-5-20250929
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

# ======================
# Market data
# ======================
# Finnhub — real-time stock quotes. 60 req/min free. https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ======================
# Backend connection
# ======================
# Local dev: http://localhost:10000   Production: your Render URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:10000

# ======================
# App URL (self-reference)
# ======================
NEXT_PUBLIC_APP_URL=http://localhost:3000
