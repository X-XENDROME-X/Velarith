{
  "name": "velarith",
  "version": "0.2.0",
  "private": true,
  "description": "AI-powered prediction market research tool",
  "author": "Team Velarith",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:backend": "cd backend && (test -d env && source env/bin/activate || true) && uvicorn main:app --reload --host 0.0.0.0 --port 10000",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:backend\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "type-check": "tsc --noEmit",
    "warmup": "bash scripts/warmup.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/groq": "^3.0.35",
    "@ai-sdk/react": "^3.0.170",
    "@anthropic-ai/sdk": "^0.91.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.99.2",
    "ai": "^6.0.168",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "lucide-react": "^1.8.0",
    "next": "^15.5.21",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "yahoo-finance2": "^3.14.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.4",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.8.3",
    "typescript": "^5.7.0"
  }
}
