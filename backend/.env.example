# Velarith — Backend Environment Variables
# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.
# Full per-variable docs live in .agents/api-keys.md

# ======================
# AI providers (two-tier routing)
# ======================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

AI_PRIMARY_PROVIDER=claude
AI_FALLBACK_PROVIDER=groq
AI_PRIMARY_MODEL=claude-sonnet-4-5-20250929
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

# ======================
# Server config
# ======================
# CORS whitelist for the FastAPI app. Comma-separated origins.
# In production, add your Vercel URL(s). Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:3000

# In-memory cache TTL for Polymarket reads (seconds)
CACHE_TTL_SECONDS=60
