# Velarith Backend Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# ============================================
# REQUIRED: Anthropic Claude AI
# ============================================
# Get your API key from: https://console.anthropic.com/
# Used for: AI summaries, market analysis
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL: CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: Add your Vercel deployment URL
CORS_ORIGINS=http://localhost:3000,https://velarith.vercel.app

# ============================================
# OPTIONAL: API Configuration
# ============================================
# Rate limiting, caching, etc.
# API_RATE_LIMIT=100
# CACHE_TTL=300

# ============================================
# OPTIONAL: Database Configuration
# ============================================
# If using database for caching or user data
# DATABASE_URL=postgresql://user:password@localhost:5432/velarith
# REDIS_URL=redis://localhost:6379/0
